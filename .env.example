# Copy the public anon/publishable key from the SAME Supabase project as Dream Poker operations.
NEXT_PUBLIC_SUPABASE_URL=https://sncvmxhhsocuamjjwgvz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never use a Supabase service-role/secret key in NEXT_PUBLIC_ variables.

# Server-only. Store credentials in the deployment's secret settings.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
STAFF_TELEGRAM_CHAT_ID=
ACCOUNTING_ENABLED=false
ACCOUNTING_OPS_SECRET=

# Preserve legacy accounting until the dedicated bot has been checked.
ACCOUNTING_BOT_MODE=legacy
ACCOUNTING_TELEGRAM_BOT_TOKEN=
ACCOUNTING_TELEGRAM_WEBHOOK_SECRET=
ACCOUNTING_TELEGRAM_CHAT_ID=
ACCOUNTING_TELEGRAM_BOT_USERNAME=dream_poker_accounting_bot
ACCOUNTING_ACTIVATED_AT=
# Optional overrides; only change reconciliation fields after checking cashier reports.
ACCOUNTING_AI_MODEL=
ACCOUNTING_RECONCILIATION_METRICS=rakeBack,fnb,mongol,japan,china,house,korea2

# Reservations reuse the existing Dream Buy-in Desk identity.
RESERVATION_AGENT_ENABLED=false
RESERVATION_TELEGRAM_CHAT_ID=
RESERVATION_TELEGRAM_ADMIN_USER_IDS=
# Optional overrides; otherwise the existing TELEGRAM_* credentials are used.
RESERVATION_TELEGRAM_BOT_TOKEN=
RESERVATION_TELEGRAM_WEBHOOK_SECRET=

# Exchange starts only after the activation instant and confirmed opening float.
EXCHANGE_ENABLED=false
EXCHANGE_TELEGRAM_BOT_TOKEN=
EXCHANGE_TELEGRAM_WEBHOOK_SECRET=
EXCHANGE_TELEGRAM_CHAT_ID=
EXCHANGE_ADMIN_USER_IDS=
EXCHANGE_ACTIVATED_AT=

AGENT_PUBLIC_URL=https://dream-poker-reservation.vercel.app
AGENT_OPS_SECRET=
# Keep the existing authenticated Google Sheets / AI Gateway configuration.
AI_GATEWAY_MODEL=openai/gpt-5-mini
